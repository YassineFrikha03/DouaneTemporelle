<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- صلاحية الكاميرا للفحص البيومتري والتحقق ضد الروبوتات -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DouaneTemporelle">

        <!-- شاشة المقدمة والشعار (Intro / Splash Screen Launcher) -->
        <activity
            android:name=".IntroActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- النشاط الأول : استمارة التسجيل -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- النشاط الثاني : فاحص التحقق والتذكرة -->
        <activity
            android:name=".VerificationActivity"
            android:exported="false" />

        <!-- النشاط الثالث : شاشة الحكم النهائي -->
        <activity
            android:name=".ResultActivity"
            android:exported="false" />

    </application>

</manifest>
