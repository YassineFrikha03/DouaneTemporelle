<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_racine_intro_yf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/time_space_dark"
    tools:context=".IntroActivity">

    <!-- Bloc Central : Uniquement le Logo officiel et la ligne de chargement centree -->
    <LinearLayout
        android:id="@+id/ll_centre_splash_yf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Logo Officiel Douanier Centré -->
        <ImageView
            android:id="@+id/iv_logo_intro_yf"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="Logo Officiel Douane"
            android:src="@drawable/ic_app_logo" />

        <!-- Ligne d'actualisation / progression fine et moderne centree sous le logo -->
        <ProgressBar
            android:id="@+id/pb_ligne_chargement_yf"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="140dp"
            android:layout_height="3dp"
            android:layout_marginTop="36dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/time_cyan" />

    </LinearLayout>

</RelativeLayout>
