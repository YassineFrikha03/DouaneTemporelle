<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_main_yf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/time_space_dark"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_container_yf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- En-tête : Badge Secteur Temporel -->
        <TextView
            android:id="@+id/tv_badge_secteur_yf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_sector"
            android:drawableStart="@drawable/ic_verified_badge"
            android:drawablePadding="8dp"
            android:letterSpacing="0.08"
            android:text="@string/sous_titre_douane"
            android:textColor="@color/time_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo / Horloge Temporelle -->
        <ImageView
            android:id="@+id/iv_logo_temporel_yf"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/titre_douane"
            android:src="@drawable/ic_time_portal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_badge_secteur_yf" />

        <!-- Titre Principal -->
        <TextView
            android:id="@+id/tv_titre_douane_yf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="@string/titre_douane"
            android:textColor="@color/time_text_primary"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo_temporel_yf" />

        <TextView
            android:id="@+id/tv_desc_douane_yf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/desc_formulaire"
            android:textColor="@color/time_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_titre_douane_yf" />

        <!-- Carte Formulaire d'Enregistrement -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_formulaire_yf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/time_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_desc_douane_yf"
            app:strokeColor="@color/time_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/layout_card_content_yf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Champ 1 : Nom du voyageur -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_nom_yf"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_nom"
                    android:textColorHint="@color/time_text_muted"
                    app:boxBackgroundColor="@color/time_input_bg"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/time_cyan"
                    app:boxStrokeErrorColor="@color/time_red"
                    app:errorTextColor="@color/time_red"
                    app:hintTextColor="@color/time_cyan"
                    app:startIconDrawable="@drawable/ic_person_voyager"
                    app:startIconTint="@color/time_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_nom_yf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords|textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/time_text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section Coordonnées Temporelles (Naiss. & Dest.) -->
                <LinearLayout
                    android:id="@+id/layout_annees_yf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Champ 2 : Année de Naissance -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_annee_naissance_yf"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/label_annee_naissance"
                        android:textColorHint="@color/time_text_muted"
                        app:boxBackgroundColor="@color/time_input_bg"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/time_cyan"
                        app:boxStrokeErrorColor="@color/time_red"
                        app:errorTextColor="@color/time_red"
                        app:hintTextColor="@color/time_cyan"
                        app:startIconDrawable="@drawable/ic_calendar_birth"
                        app:startIconTint="@color/time_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_annee_naissance_yf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberSigned"
                            android:maxLength="5"
                            android:textColor="@color/time_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Champ 3 : Année de Destination -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_annee_destination_yf"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/label_annee_destination"
                        android:textColorHint="@color/time_text_muted"
                        app:boxBackgroundColor="@color/time_input_bg"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/time_cyan"
                        app:boxStrokeErrorColor="@color/time_red"
                        app:errorTextColor="@color/time_red"
                        app:hintTextColor="@color/time_cyan"
                        app:startIconDrawable="@drawable/ic_rocket_destination"
                        app:startIconTint="@color/time_cyan">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_annee_destination_yf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="numberSigned"
                            android:maxLength="5"
                            android:textColor="@color/time_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Feedback interactif UI/UX : Calcul dynamique du saut temporel -->
                <TextView
                    android:id="@+id/tv_apercu_temporel_yf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_feedback_box"
                    android:text="@string/apercu_attente"
                    android:textColor="@color/time_text_secondary"
                    android:textSize="13sp" />

                <!-- Champ 4 : Motif du voyage -->
                <TextView
                    android:id="@+id/tv_titre_motif_yf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_motif_voyage"
                    android:textColor="@color/time_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_motif_yf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_tourisme_yf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:buttonTint="@color/time_cyan"
                        android:checked="true"
                        android:text="@string/motif_tourisme"
                        android:textColor="@color/time_text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_modification_yf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:buttonTint="@color/time_amber"
                        android:text="@string/motif_modification"
                        android:textColor="@color/time_text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_fuite_yf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/time_purple"
                        android:text="@string/motif_fuite"
                        android:textColor="@color/time_text_primary"
                        android:textSize="14sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton d'Action Principal : Inspecter le profil -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_inspecter_yf"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/time_cyan"
            android:letterSpacing="0.06"
            android:text="@string/btn_inspecter_profil"
            android:textColor="@color/time_space_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_scan_profile"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/time_space_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_formulaire_yf"
            app:rippleColor="@color/white" />

        <!-- Note de Sécurité Temporelle en bas -->
        <TextView
            android:id="@+id/tv_footer_securite_yf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="🔒 Données cryptées selon le Protocole Chronologique Standard"
            android:textColor="@color/time_text_muted"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_inspecter_yf" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
