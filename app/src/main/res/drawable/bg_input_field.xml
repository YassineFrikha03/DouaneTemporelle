<?xml version="1.0" encoding="utf-8"?>
<!-- مظهر حقول الإدخال مع تأثير التركيز بلون السيان -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_chronos_input" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/border_chronos_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_chronos_input" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border_chronos_card" />
        </shape>
    </item>
</selector>
